# ==============================
# Root / Node monorepo
# ==============================
node_modules/
npm-debug.*
yarn-debug.*
yarn-error.*
*.tsbuildinfo
.DS_Store
Thumbs.db
*.log
.env
.env.*
!.env.example
!.env.testing

# ==============================
# Laravel backend (backend/)
# ==============================
backend/node_modules/
backend/public/build/
backend/public/hot/
backend/public/storage/
backend/storage/*.key
backend/storage/app/*
!backend/storage/app/.gitignore
backend/storage/framework/cache/*
!backend/storage/framework/cache/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/testing/*
!backend/storage/framework/testing/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/logs/*
!backend/storage/logs/.gitignore
backend/storage/pail
backend/bootstrap/cache/*
!backend/bootstrap/cache/.gitignore
backend/vendor/
backend/.env
backend/.env.backup
backend/.env.production
backend/.phpactor.json
backend/.phpunit.cache
backend/.phpunit.result.cache
backend/auth.json
backend/Homestead.json
backend/Homestead.yaml
backend/.fleet
backend/.idea
backend/.nova
backend/.vscode
backend/.zed
backend/database/*.sqlite

# ==============================
# Expo / React Native apps (apps/*)
# ==============================
apps/*/node_modules/
apps/*/.expo/
apps/*/dist/
apps/*/web-build/
apps/*/expo-env.d.ts
apps/*/.kotlin/
apps/*/*.orig.*
apps/*/*.jks
apps/*/*.p8
apps/*/*.p12
apps/*/*.key
apps/*/*.mobileprovision
apps/*/.metro-health-check*
apps/*/.env*.local
apps/*/*.tsbuildinfo
apps/*/ios/
apps/*/android/

# ==============================
# Packages (shared workspace libs)
# ==============================
packages/*/node_modules/
packages/*/dist/
packages/*/*.tsbuildinfo

# ==============================
# Editors / OS
# ==============================
.vscode/
.idea/
*.swp
*.pem
