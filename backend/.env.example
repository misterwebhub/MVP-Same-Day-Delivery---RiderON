APP_NAME=RiderON
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rideron
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Use 'redis' in staging/production (requires REDIS_* below to point at a real server).
CACHE_STORE=database
CACHE_PREFIX=rideron_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@rideron.in"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# RiderON application settings
# ---------------------------------------------------------------------------
APP_FRONTEND_SUPPORT_PHONE="+917001234567"

# Provider drivers: mock | real-provider-name. Mock is the safe default for local/dev.
PAYMENT_DRIVER=mock
SMS_DRIVER=mock
PUSH_DRIVER=mock
CALL_DRIVER=mock

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

HANUOTP_API_KEY=
HANUOTP_BASE_URL=https://api.hanuotp.in/sms-otp.php
HANUOTP_TEMPLATE_ID=default

FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

EXOTEL_SID=
EXOTEL_TOKEN=
EXOTEL_CALLER_ID=

OTP_LENGTH=4
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15
OTP_MAX_RESENDS=3
OTP_RESEND_COOLDOWN_SECONDS=60

QUOTE_TOKEN_TTL_MINUTES=10
PAYMENT_PENDING_TIMEOUT_MINUTES=20
ORDER_AUTO_COMPLETE_MINUTES=30

SANCTUM_ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30
AUTH_OTP_REQUEST_MAX_PER_PHONE_PER_HOUR=3
AUTH_OTP_REQUEST_MAX_PER_IP_PER_HOUR=10
